# comment-ai-tool 环境变量模板
# 复制为 .env 后填入真实值

# === 数据库 ===
MYSQL_ROOT_PASSWORD=comment_ai_pass
# 本地开发用 SQLite: DB_URL=sqlite+aiosqlite:///./comment_ai.db
# DB_URL=mysql+aiomysql://root:comment_ai_pass@localhost:3306/comment_ai

# === AI ===
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# === MoneyPrinterTurbo ===
MPT_BASE_URL=http://localhost:8080
MPT_ENABLED=false

# === Obsidian ===
# OBSIDIAN_VAULT_PATH=/mnt/c/Users/24961/Documents/大模型笔记

# === 平台凭证 ===
# DOUYIN_ACCESS_TOKEN=
# XHS_COOKIE=
# WECHAT_APPID=
# WECHAT_SECRET=
# BILIBILI_COOKIE=
# BILIBILI_CSRF=

# === 业务参数 ===
CHECK_INTERVAL_SECONDS=300
MIN_LEAD_SCORE=0.6
APP_PORT=8000
