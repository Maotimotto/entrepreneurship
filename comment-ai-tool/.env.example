# === AI 模型配置 ===
# 支持: openai / dashscope (通义千问) / wenxin (文心一言)
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# === 抖音开放平台 ===
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_ACCESS_TOKEN=

# === 小红书 (后续接入) ===
XHS_COOKIE=

# === 服务配置 ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# === 数据库 ===
DATABASE_URL=sqlite+aiosqlite:///./comment_ai.db
